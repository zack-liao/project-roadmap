{
	// Cloudflare 上的 Worker 專案名稱必須與這裡的 name 一致
	"name": "project-roadmap",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-15",
	// 前端 build 產物由 Worker 直接供應；找不到的路徑回 index.html 交給 SPA router
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		// 只有 /api/* 交給 Worker，其餘路徑一律先找靜態檔
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "project-roadmap-db",
			"database_id": "a70a5300-4fac-4359-acac-99e00e1fee77"
		}
	]
}